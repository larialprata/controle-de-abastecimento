{
  "name": "controle-abast-mobile",
  "version": "1.3.0",
  "main": "index.ts",
  "scripts": {
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "icons:android": "npm run icons:generate && npx expo prebuild --platform android --no-install",
    "preandroid": "node scripts/patch-foojay-gradle.cjs && node scripts/sync-android-autolinking.cjs",
    "prestart": "node scripts/sync-android-autolinking.cjs",
    "android:device": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-android-device.ps1 && npx expo run:android",
    "repair:deps": "powershell -ExecutionPolicy Bypass -File ./scripts/repair-monorepo-deps.ps1",
    "start": "npx expo start",
    "android": "npx expo run:android",
    "android:setup-win": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-short-path.ps1",
    "android:win": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android-windows.ps1",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "update:preview": "eas update --channel preview --message \"OTA preview\"",
    "update:production": "eas update --channel production --message \"OTA production\""
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-native-picker/picker": "2.11.4",
    "@supabase/supabase-js": "^2.100.0",
    "expo": "~55.0.26",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.14",
    "expo-camera": "~55.0.10",
    "expo-file-system": "~55.0.12",
    "expo-image-picker": "~55.0.20",
    "expo-location": "~55.1.10",
    "expo-media-library": "~55.0.17",
    "expo-sqlite": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.24",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-get-random-values": "~1.11.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "^13.16.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "jimp": "^1.6.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
