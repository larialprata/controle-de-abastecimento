# Copie para .env e preencha. Variáveis VITE_* são embutidas no build do front — use só a chave anon.
# NUNCA commite .env nem a service_role do Supabase aqui.

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_publica
VITE_API_URL=http://localhost:3001

# Opcional: mapa no BI (Tanque / Melosa). Restrinja a chave no Google Cloud Console.
# VITE_GOOGLE_MAPS_API_KEY=
