# Copie para .env e preencha com os valores do Supabase (Project Settings → API).
# NUNCA commite o arquivo .env — ele contém chaves secretas.

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_publica
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_apenas_no_servidor

PORT=3001

# Opcional — para npm run migrate:equipamento-empresa
# DATABASE_URL=postgresql://postgres.[ref]:[SENHA]@aws-0-[regiao].pooler.supabase.com:6543/postgres

# Opcional — Controle de Equipamentos (QR e dados do ativo)
# Preferencial: Supabase do projeto de equipamentos (Settings → API no dashboard Supabase)
EQUIPAMENTOS_SUPABASE_URL=https://jcgcqkselizmokrlmven.supabase.co
EQUIPAMENTOS_SUPABASE_SERVICE_ROLE_KEY=sua_service_role_do_projeto_equipamentos
# URL pública do app de equipamentos (conteúdo do QR): https://controle.dimensionalengenharia.com/q/{token}
EQUIPAMENTOS_QR_PUBLIC_BASE_URL=https://controle.dimensionalengenharia.com
# Legado (opcional): conexão Postgres direta — use só se não tiver a service role
# EQUIPAMENTOS_DB_URL=postgresql://postgres.[ref]:[senha]@...pooler.supabase.com:6543/postgres?pgbouncer=true

# Buckets (opcional — defaults no código; no SharePoint viram subpastas)
# CNH_BUCKET=cnh
# NOTAS_BUCKET=notas

# --- Storage: sharepoint (padrão) | supabase (legado) ---
# STORAGE_PROVIDER=sharepoint
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_SITE_ID=contoso.sharepoint.com,site-guid,web-guid
# SHAREPOINT_FOLDER_CNH=Teste/CNH
# SHAREPOINT_FOLDER_OPERATION=Teste/Combustível
# (Documentos já é a biblioteca — NÃO prefixar com "documentos/")

# Primeiro admin (opcional — usado por npm run seed:admin)
# SEED_ADMIN_EMAIL=admin@exemplo.com
# SEED_ADMIN_PASSWORD=troque_esta_senha
# SEED_ADMIN_CPF=99999999999

# Relatório diário por e-mail
# Opção A (recomendado, sem SMTP da Microsoft): https://resend.com → API Keys
# RESEND_API_KEY=re_xxxxxxxx
# Opcional: após verificar o domínio no Resend
# RESEND_FROM="Controle Abastecimento <supabase@dimensionalengenharia.com>"
# Sem RESEND_FROM, usa onboarding@resend.dev (só envia para o e-mail da conta Resend)

# Opção B — SMTP Microsoft (exige SMTP AUTH liberado pelo TI)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@dimensionalengenharia.com
# SMTP_PASS=
# SMTP_FROM="Controle Abastecimento <noreply@dimensionalengenharia.com>"
# Hora (0–23) America/Sao_Paulo para envio automático; omita para desligar
# DAILY_REPORT_HOUR=18
# Segredo para cron externo: POST /v1/admin/report-email/run-daily com header X-Cron-Secret
# CRON_SECRET=troque_este_segredo
