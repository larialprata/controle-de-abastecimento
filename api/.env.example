# Copie para .env e preencha com os valores do Supabase (Project Settings → API).
# NUNCA commite o arquivo .env — ele contém chaves secretas.

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_publica
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_apenas_no_servidor

PORT=3001

# Opcional — para npm run migrate:equipamento-empresa
# DATABASE_URL=postgresql://postgres.[ref]:[SENHA]@aws-0-[regiao].pooler.supabase.com:6543/postgres

# Opcional — banco do Controle de Equipamentos (Postgres/Prisma) para buscar QR por ativo+obra
# EQUIPAMENTOS_DB_URL=postgresql://usuario:senha@host:5432/banco
# URL pública do app de equipamentos (conteúdo do QR impresso): https://seu-dominio/q/{token}
# EQUIPAMENTOS_QR_PUBLIC_BASE_URL=https://equipamentos.exemplo.com

# Buckets (opcional — defaults no código)
# CNH_BUCKET=cnh
# NOTAS_BUCKET=notas

# Primeiro admin (opcional — usado por npm run seed:admin)
# SEED_ADMIN_EMAIL=admin@exemplo.com
# SEED_ADMIN_PASSWORD=troque_esta_senha
# SEED_ADMIN_CPF=99999999999
